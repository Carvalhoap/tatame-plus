rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function activeMemberExists(academyId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }

    function isAdminOrPartner(academyId) {
      return activeMemberExists(academyId)
        && (
          firestore.get(
            /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
          ).data.roles.admin == true
          ||
          firestore.get(
            /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
          ).data.roles.partner == true
        );
    }

    function studentExists(academyId, studentId) {
      return firestore.exists(
        /databases/(default)/documents/academies/$(academyId)/students/$(studentId)
      );
    }

    function ownsStudent(academyId, studentId) {
      return activeMemberExists(academyId)
        && studentExists(academyId, studentId)
        && firestore.get(
          /databases/(default)/documents/academies/$(academyId)/students/$(studentId)
        ).data.userId == request.auth.uid;
    }

    function guardsStudent(academyId, studentId) {
      return activeMemberExists(academyId)
        && firestore.get(
          /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
        ).data.roles.guardian == true
        && studentExists(academyId, studentId)
        && firestore.get(
          /databases/(default)/documents/academies/$(academyId)/students/$(studentId)
        ).data.guardianIds is list
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/academies/$(academyId)/students/$(studentId)
        ).data.guardianIds;
    }

    function canAccessStudent(academyId, studentId) {
      return isAdminOrPartner(academyId)
        || ownsStudent(academyId, studentId)
        || guardsStudent(academyId, studentId);
    }

    match /academies/{academyId}/financeProofs/{studentId}/{fileName} {
      allow read:
        if canAccessStudent(academyId, studentId);

      allow create:
        if (
          ownsStudent(academyId, studentId)
          || guardsStudent(academyId, studentId)
        )
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow update:
        if false;

      allow delete:
        if false;
    }

    match /academies/{academyId}/legalDocuments/{documentId}/versions/{version}/{fileName} {
      allow read:
        if activeMemberExists(academyId)
          && (
            isAdminOrPartner(academyId)
            || (
              firestore.exists(
                /databases/(default)/documents/academies/$(academyId)/legalDocuments/$(documentId)
              )
              && firestore.get(
                /databases/(default)/documents/academies/$(academyId)/legalDocuments/$(documentId)
              ).data.status == 'published'
            )
          );

      allow create:
        if activeMemberExists(academyId)
          && firestore.get(
            /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
          ).data.roles.admin == true
          && request.resource.size > 0
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType == 'application/pdf';

      allow update, delete: if false;
    }

    match /academies/{academyId}/signedDocuments/{studentId}/{assignmentId}/{fileName} {
      function canReadSignedPdf() {
        let signature = firestore.get(
          /databases/(default)/documents/academies/$(academyId)/documentSignatures/$(assignmentId)
        ).data;

        let member = firestore.get(
          /databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid)
        ).data;

        return signature.studentId == studentId
          && signature.assignmentId == assignmentId
          && signature.signedPdfStoragePath ==
            'academies/' + academyId +
            '/signedDocuments/' + studentId +
            '/' + assignmentId + '/' + fileName
          && (
            signature.signerUserId == request.auth.uid
            || member.roles.get('admin', false) == true
            || member.roles.get('partner', false) == true
          );
      }

      allow read:
        if activeMemberExists(academyId)
          && canReadSignedPdf();

      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
